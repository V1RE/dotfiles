#!/bin/sh

set -eu

# fallow.usage.kdl hash: {{ include "dot_zsh/completions/fallow.usage.kdl" | sha256sum }}
spec="${HOME}/.zsh/completions/fallow.usage.kdl"
completion="${HOME}/.zsh/_fallow"
temp="$(mktemp "${completion}.XXXXXX")"
trap 'rm -f "${temp}"' EXIT HUP INT TERM

usage generate completion zsh fallow --file "${spec}" > "${temp}"
mv -f "${temp}" "${completion}"
trap - EXIT HUP INT TERM
