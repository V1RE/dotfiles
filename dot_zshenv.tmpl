typeset -gU path PATH
path=(
  $HOME/.ascii/bin
  $HOME/.local/bin
  $HOME/bin
  $HOME/go/bin
  $HOME/.opencode/bin(N-/)
  $HOME/.bun/bin(N-/)
  $path
)

export BUN_INSTALL="$HOME/.bun" # data dir only; bins via `mise activate`
export ANDROID_HOME="$HOME/Library/Android/sdk"
[[ -d $ANDROID_HOME ]] && path+=($ANDROID_HOME/{emulator,platform-tools,cmdline-tools/latest/bin}(N-/))

[ -r "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Vite+ bin (https://viteplus.dev)
[ -r "$HOME/.vite-plus/env" ] && . "$HOME/.vite-plus/env"

# ASCII BOAT SHELL INTEGRATION START boat
case ":$PATH:" in
  *":{{ .chezmoi.homeDir }}/.ascii/bin:"*) ;;
  *) PATH="{{ .chezmoi.homeDir }}/.ascii/bin:$PATH" ;;
esac
export PATH
# ASCII BOAT SHELL INTEGRATION END boat
