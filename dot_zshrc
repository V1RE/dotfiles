# Compile $1 to $1.zwc atomically. Concurrent shells must never observe a
# half-written .zwc, so compile to a pid-unique temp and rename over the target.
function zsh-cache-compile() {
    emulate -L zsh
    local src=$1 tmp=$1.$$.zwc
    if zcompile -R -- $tmp $src 2>/dev/null; then
        mv -f -- $tmp $src.zwc 2>/dev/null || rm -f -- $tmp
    else
        rm -f -- $tmp
    fi
}

# Compile hot-path scripts, skipping any whose .zwc is already current.
# An unconditional rebuild would make concurrent shells race over one output.
function zsh-compile-if-stale() {
    emulate -L zsh
    local src
    for src in $@; do
        [[ -s $src ]] || continue
        [[ -s $src.zwc && $src.zwc -nt $src ]] && continue
        zsh-cache-compile $src
    done
}

# Resolve the cache file holding the stdout of a slow shell-init command,
# regenerating it when stale. The path is returned in $REPLY.
#
#   zsh-cache-file [-b <keybin>] [-w <file>]... <name> <cmd> [args...]
#
# Callers MUST `source $REPLY` themselves, at the top level of .zshrc. Sourcing
# inside this function would break two things: `emulate -L` implies
# LOCAL_OPTIONS, so a `setopt` in the init script (starship needs promptsubst)
# would be reverted on return; and a bare `typeset` in the init script would
# become function-local instead of global.
#
# The cache key covers, for the *resolved* command path and every -w file: the
# device and inode, plus mtime and size. Resolution matters because starship,
# mole, zoxide, wt, pitchfork and vp are all symlinks into versioned
# directories. Device+inode is what actually pins identity: an upgrade repoints
# the symlink at a different file, which changes the inode even in the case
# where the new target happens to preserve both mtime and size. The key is
# encoded into the cache filename, so one stat decides validity.
#
#   -b  key on this command instead of <cmd>, for `env VAR=x tool` forms
#   -w  add a config file to the key; repeatable
#
# Determinism is not assumed forever: ZSH_CACHE_TTL_DAYS forces a periodic
# rebuild. If generation fails the previous good cache is kept. Returns non-zero
# and clears REPLY when there is nothing to source, so `&& source $REPLY` is
# always safe and a failed call can never leak the previous call's cache path.
function zsh-cache-file() {
    emulate -L zsh -o extended_glob
    typeset -g REPLY=
    local keybin= name cache tmp exe f key cmd
    local -a watch old
    while true; do
        case $1 in
            (-b) keybin=$2; shift 2 ;;
            (-w) watch+=$2; shift 2 ;;
            (*) break ;;
        esac
    done
    name=$1; shift
    cmd=${keybin:-$1}
    # $commands is the fast, fork-free lookup, but it is an ordinary parameter
    # name that any caller up the stack may shadow: zsh-vi-mode's
    # zvm_exec_commands does `local commands=...`, which silently broke this
    # lookup for everything it invokes. Indexing a shadowed scalar is worse than
    # empty -- the subscript is evaluated arithmetically, so `${commands[3]}`
    # can return a stray character that is not an executable. Only trust the
    # parameter when it is still the special association; otherwise pay one
    # `whence -p`, which reads the real command table and cannot be shadowed.
    if [[ ${(t)commands} == association*special* ]]; then
        exe=${commands[$cmd]}
    else
        exe=
    fi
    [[ -n $exe ]] || exe=$(builtin whence -p -- $cmd 2>/dev/null)
    [[ -n $exe ]] || return 1

    local -A st
    for f in ${exe:A} $watch; do
        zstat -H st -- $f 2>/dev/null || continue
        key+=.$st[device].$st[inode].$st[mtime].$st[size]
    done
    cache=$ZSH_CACHE_DIR/$name$key.zsh

    local stale=0
    if [[ ! -s $cache ]]; then
        stale=1
    elif zstat -H st -- $cache 2>/dev/null; then
        (( EPOCHSECONDS - st[mtime] > ZSH_CACHE_TTL_DAYS * 86400 )) && stale=1
    fi

    if (( stale )); then
        tmp=$cache.$$.tmp
        if "$@" >| $tmp 2>/dev/null && [[ -s $tmp ]]; then
            old=($ZSH_CACHE_DIR/$name.*.zsh(#qN) $ZSH_CACHE_DIR/$name.*.zsh.zwc(#qN))
            (( $#old )) && rm -f -- $old
            mv -f -- $tmp $cache
            zsh-cache-compile $cache
        else
            rm -f -- $tmp
        fi
    fi

    [[ -s $cache ]] || return 1
    typeset -g REPLY=$cache
}

