{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "mcp": {
    "servers": {
      "executor": {
        "type": "remote",
        "url": "https://v2.executor.sh/mcp"
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:POSTHOG_MCP_KEY}",
          "x-posthog-mcp-mode": "cli"
        },
        "oauth": false,
        "disabled": true
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "1601185624273.8899143856786",
          "redirect_uri": "http://localhost:3118/callback"
        },
        "disabled": true
      },
      "websearch-exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
        "disabled": false
      }
    }
  },
  "references": {
    "effect": {
      "repository": "Effect-TS/effect"
    },
    "alchemy": {
      "repository": "alchemy-run/alchemy"
    },
    "opencode": {
      "repository": "anomalyco/opencode"
    }
  },
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "explore": {
      "model": "github-copilot/claude-haiku-5.5",
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "general": {
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "$HOME/.opensrc/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "$HOME/Code/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "$HOME/.local/share/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ],
  "experimental": {
    "portable_shell_scanner": true
  }
}
