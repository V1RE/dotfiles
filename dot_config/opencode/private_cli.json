{
  "theme": {
    "name": "ayu",
    "mode": "dark"
  },
  "keybinds": {
    "input_undo": "ctrl+-,super+z,option+z"
  },
  "scroll": {
    "speed": 6,
    "acceleration": true
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "volume": 0.9999999999999999
  },
  "diffs": {
    "wrap": "word",
    "single": true,
    "view": "auto",
    "tree": true
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "paste": "compact"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "grouping": "auto",
    "markdown": "rendered"
  },
  "hints": {
    "onboarding": true
  },
  "animations": true,
  "debug": {
    "devtools": true,
    "timing": true,
    "turn_tokens": "verbose"
  },
  "tabs": {
    "enabled": true,
    "scope": "cwd",
    "vertical": false
  }
}
