{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "orng",
    "mode": "system"
  },
  "mini": {
    "thinking": "show",
    "shell_output": "show",
    "turn_summary": "show",
    "footer": "show",
    "splash": "show",
    "mono": false,
    "replay": true
  },
  "leader": {
    "timeout": 2000
  },
  "mouse": true,
  "cursor": {
    "style": "line",
    "blinking": true
  },
  "keybinds": {
    "input.undo": "ctrl+-,super+z,alt+z"
  },
  "scroll": {
    "speed": 6,
    "acceleration": true
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "volume": 1
  },
  "diffs": {
    "wrap": "word",
    "single": true,
    "view": "unified",
    "tree": true
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true,
    "editor": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "grouping": "auto",
    "markdown": "rendered",
    "new_location": "launch",
    "image_preview": true,
    "terminal": true,
    "tps": true
  },
  "hints": {
    "onboarding": true
  },
  "animations": true,
  "debug": {
    "devtools": true,
    "timing": true,
    "turn_tokens": "verbose"
  },
  "tabs": {
    "enabled": true,
    "scope": "cwd",
    "vertical": false,
    "layout": "horizontal"
  },
  "experimental": {
    "tab_scroll": true,
    "session-preview-tabs": true
  }
}
