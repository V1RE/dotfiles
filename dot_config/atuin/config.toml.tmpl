enter_accept = false
keymap_mode = "auto"
search_mode = "daemon-fuzzy"

[stats]
common_subcommands = [
  "apt",
  "cargo",
  "composer",
  "dnf",
  "docker",
  "git",
  "go",
  "ip",
  "kubectl",
  "nix",
  "nmcli",
  "npm",
  "pecl",
  "pnpm",
  "podman",
  "port",
  "systemctl",
  "tmux",
  "yarn",
  "mise",
  "pnpx",
  "bun",
  "bunx",
  "eas",
]

[keys]

[sync]
records = true

[preview]

[daemon]
enabled = true
autostart = true

[ui]
columns = ["time", "directory", "command"]

[ai]
enabled = true

[threads]
# Opt in per machine via chezmoi data; captured threads use the existing sync.
capture = {{ and (hasKey . "atuinThreadsCapture") (get . "atuinThreadsCapture") }}
capture_tools = true

[pty_proxy]
enabled = {{ and (hasKey . "atuinOutputCapture") (get . "atuinOutputCapture") }}

[output]
enabled = {{ and (hasKey . "atuinOutputCapture") (get . "atuinOutputCapture") }}
# Bound local storage instead of upstream's default 10% of the disk.
max_disk_usage = "1GB"
max_output_size = "1MB"
