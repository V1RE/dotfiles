{{- /* Raycast gives every device and app its own MCP token, so it lives in this
     machine's Keychain, not in the repo. Store it once per Mac with:
     security add-generic-password -U -s raycast-mcp -a amp -w
     Without it, the raycast server is left out. */ -}}
{{- $raycastToken := output "sh" "-c" "security find-generic-password -s raycast-mcp -a amp -w 2>/dev/null || true" | trim -}}
{
  "$schema": "https://ampcode.com/cli-settings.schema.json",
  "amp.runner.env.enabled": true,
  "amp.showCosts": true,
  "amp.git.commit.coauthor.enabled": true,
  "amp.git.commit.ampThread.enabled": true,
  "amp.notifications.enabled": true,
  "amp.skills.disableClaudeCodeSkills": true,
  "amp.skills.disableGlobalAgentsSkills": false,
  "amp.terminal.copyOnSelect": true,
  "amp.terminal.detailsExpandedByDefault": true,
  "amp.thread.autoArchiveOnQuit": false,
  "amp.tools.disable": [],
  "amp.fuzzy.alwaysIncludePaths": [
    ".env",
    ".env.*"
  ],
  "amp.defaultVisibility": {},
  "amp.mcpPermissions": [],
  "amp.remoteThreadCreation.enabled": true,
  "amp.runner.autoUpdate.enabled": true,
  "amp.updates.mode": "auto",
  "amp.keymap": {
    "thread.new": "ctrl+t",
    "thread.switch": "alt+o",
    "thread.toggleOutline": "<leader>m"
  },
  "amp.mcpServers": {
{{- if $raycastToken }}
    "raycast": {
      "url": "http://127.0.0.1:8267/mcp",
      "headers": {
        "Authorization": {{ printf "Bearer %s" $raycastToken | toJson }}
      }
    }
  }
{{- else }}}
{{- end }}
}
