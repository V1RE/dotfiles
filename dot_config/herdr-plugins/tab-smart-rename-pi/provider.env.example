# Smart Rename settings. Copy this file to Herdr's private plugin config.
# No API key belongs here: credentials, the model catalog, and the default
# model all come from your own Pi installation (~/.pi/agent).
SMART_RENAME_TIMEOUT_MS=45000
# Optional custom naming prompt. Relative paths resolve from this directory.
# SMART_RENAME_PROMPT_PATH=naming-prompt.md
