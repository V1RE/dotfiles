{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash

set -euo pipefail

# Install only after chezmoi has deployed the platform and role profiles.
# config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# macos hash: {{ include "dot_config/mise/config.macos.toml" | sha256sum }}
# linux hash: {{ include "dot_config/mise/config.linux.toml" | sha256sum }}
# desktop hash: {{ include "dot_config/mise/config.desktop.toml" | sha256sum }}
# worker hash: {{ include "dot_config/mise/config.worker.toml" | sha256sum }}
# miserc hash: {{ include "dot_config/mise/miserc.toml.tmpl" | sha256sum }}
# role: {{ if or (and (hasKey . "hasGUI") (get . "hasGUI")) (and (not (hasKey . "hasGUI")) (eq .chezmoi.os "darwin")) }}desktop{{ else }}worker{{ end }}

export PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"

if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
  github_token="$(gh auth token 2>/dev/null || true)"
  if [ -n "${github_token}" ]; then
    export GITHUB_TOKEN="${github_token}"
  fi
  unset github_token
fi

mise install --yes
mise reshim
{{- end -}}
