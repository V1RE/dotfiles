        'install:Install dependencies'
        'i:Alias for install'
        'ci:Perform a clean lockfile install'
        'add:Add dependencies'
        'a:Alias for add'
        'remove:Remove dependencies'
        'rm:Alias for remove'
        'update:Update dependencies within range'
        'up:Alias for update'
        'import:Generate a lockfile from another package manager'
        'dedupe:Remove duplicate packages'
        'prune:Remove extraneous packages'
        'rebuild:Rebuild native modules'
        'rb:Alias for rebuild'
        'link:Link a local package'
        'ln:Alias for link'
        'unlink:Unlink a local package'
        'patch:Prepare a package patch'
        'patch-commit:Commit a package patch'
        'patch-remove:Remove a package patch'
        'approve-builds:Manage build-script approval'
        'ignored-builds:List ignored build scripts'
        'list:List installed dependencies'
        'ls:Alias for list'
        'why:Explain why a package is installed'
        'outdated:List outdated dependencies'
        'audit:Audit dependencies'
        'licenses:Inspect dependency licenses'
        'view:Show registry package metadata'
        'search:Search registry packages'
        'bin:Show the project binary directory'
        'root:Show the project node_modules directory'
        'query:Query dependencies'
        'check:Check dependency consistency'
        'sbom:Generate a software bill of materials'
        'publish:Publish a package'
        'pack:Create a package tarball'
        'version:Bump the package version'
        'dist-tag:Manage distribution tags'
