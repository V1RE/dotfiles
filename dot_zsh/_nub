#compdef nub

_nub_project_root() {
    local dir=$PWD
    while [[ $dir != / && ! -f $dir/package.json ]]; do
        dir=${dir:h}
    done
    [[ -f $dir/package.json ]] || return 1
    REPLY=$dir
}

_nub_scripts() {
    local root
    local -a scripts
    _nub_project_root || return 1
    root=$REPLY
    (( $+commands[jq] )) || return 1
    scripts=("${(@f)$(command jq -r '.scripts // {} | keys[]' "$root/package.json" 2>/dev/null)}")
    (( ${#scripts} )) && _describe 'script' scripts
}

_nub_bins() {
    local root
    local -a bins
    _nub_project_root || return 1
    root=$REPLY
    bins=($root/node_modules/.bin/*(N:t))
    (( ${#bins} )) && _describe 'binary' bins
}

