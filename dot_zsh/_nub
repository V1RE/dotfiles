_nub() {
    local context state line
    typeset -A opt_args

    _arguments -C \
        '--cwd[Run as if started in a directory]:directory:_directories' \
        '(-s --silent)'{-s,--silent}'[Suppress non-error output]' \
        '*--verbose[Increase log verbosity]' \
        '--color=-[Set color mode]:mode:(auto always never)' \
        '--env-file[Load environment variables]:file:_files' \
        '--env-file-if-exists[Load an optional environment file]:file:_files' \
        '--no-env-file[Disable environment-file loading]' \
        '--node[Disable nub runtime augmentation]' \
        '--watch[Enable watch mode]' \
        '(-v -V --version)'{-v,-V,--version}'[Show version]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1:command or file:_nub_first_argument' \
        '*::argument:->command'

    case $state in
        command)
            case $line[1] in
                run)
                    _arguments \
                        '--node[Disable nub runtime augmentation]' \
                        '(-r --recursive --workspaces)'{-r,--recursive,--workspaces}'[Run in all workspace packages]' \
                        '*'{-F,--filter}'[Filter workspace packages]:filter:' \
                        '*--workspace[Select a workspace]:workspace:' \
                        '(-w --workspace-root)'{-w,--workspace-root}'[Run from the workspace root]' \
                        '--include-workspace-root[Include the workspace root]' \
                        '--fail-if-no-match[Fail when no workspace matches]' \
                        '--ignore-scripts[Skip lifecycle hooks]' \
                        '--script-shell[Override the script shell]:shell:_command_names -e' \
                        '--aggregate-output[Buffer package output]' \
                        '--resume-from[Resume from a package]:package:' \
                        '--workspace-concurrency[Maximum concurrent packages]:count:' \
                        '--parallel[Run packages without topological ordering]' \
                        '--bail[Stop on first failure]' \
                        '--no-bail[Collect all failures]' \
                        '--reverse[Use reverse topological order]' \
                        '--no-sort[Disable topological sorting]' \
                        '--sequential[Run packages sequentially]' \
                        '--stream[Stream prefixed package output]' \
                        '--reporter[Select output reporter]:reporter:(default silent ndjson)' \
                        '--reporter-hide-prefix[Hide streamed output prefixes]' \
                        '--if-present[Skip packages without the script]' \
                        '--no-check[Skip dependency freshness checks]' \
                        '--cwd[Run as if started in a directory]:directory:_directories' \
                        '(-s --silent)'{-s,--silent}'[Suppress non-error output]' \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '1:script:_nub_scripts' \
                        '*:script argument:'
                    ;;
                exec)
                    _arguments \
                        '--node[Disable nub runtime augmentation]' \
                        '(-r --recursive --workspaces)'{-r,--recursive,--workspaces}'[Run in all workspace packages]' \
                        '*'{-F,--filter}'[Filter workspace packages]:filter:' \
                        '*--workspace[Select a workspace]:workspace:' \
                        '(-w --workspace-root)'{-w,--workspace-root}'[Run from the workspace root]' \
                        '--include-workspace-root[Include the workspace root]' \
                        '--fail-if-no-match[Fail when no workspace matches]' \
                        '--workspace-concurrency[Maximum concurrent packages]:count:' \
                        '--parallel[Run packages without topological ordering]' \
                        '--no-check[Skip dependency freshness checks]' \
                        '--cwd[Run as if started in a directory]:directory:_directories' \
                        '(-s --silent)'{-s,--silent}'[Suppress non-error output]' \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '1:binary:_nub_bins' \
                        '*:binary argument:'
                    ;;
                dlx|x)
                    _arguments \
                        '*'{-p,--package}'[Fetch an explicit package]:package:' \
                        '--no-install[Do not fetch missing packages]' \
                        '--no[Alias for --no-install]' \
                        '(-q --quiet)'{-q,--quiet}'[Suppress fetch progress]' \
                        '(-y --yes)'{-y,--yes}'[Accept registry fetches]' \
                        '--ignore-existing[Accepted for npx compatibility]' \
                        '--no-check[Skip dependency freshness checks]' \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '1:package:' \
                        '*:package argument:'
                    ;;
                watch)
                    _arguments \
                        '--cwd[Run as if started in a directory]:directory:_directories' \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '1:file:_files' \
                        '*:file argument:'
                    ;;
                init)
                    _arguments \
                        '(-y --yes)'{-y,--yes}'[Use defaults without prompting]' \
                        '--js[Create a JavaScript project]' \
                        '--name[Set the project name]:name:' \
                        '--no-git[Skip repository initialization]' \
                        '--no-install[Skip dependency installation]' \
                        '--force[Overwrite existing files]' \
                        '(-h --help)'{-h,--help}'[Show help]'
                    ;;
                upgrade)
                    _arguments \
                        '--version[Target version]:version:' \
                        '--canary[Upgrade to canary]' \
                        '--stable[Upgrade to stable]' \
                        '--dry-run[Show actions without changing anything]' \
                        '(-y --yes)'{-y,--yes}'[Skip confirmation]' \
                        '(-h --help)'{-h,--help}'[Show help]'
                    ;;
                node)
                    _arguments \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '1:node command:_nub_node_commands' \
                        '*:version:'
                    ;;
                pm)
                    _arguments \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '1:package-manager command:_nub_pm_commands' \
                        '*:argument:'
                    ;;
                install|i|ci)
                    _arguments \
                        '--frozen-lockfile[Fail when the lockfile is stale]' \
                        '--no-frozen-lockfile[Always resolve dependencies]' \
                        '--prefer-frozen-lockfile[Reuse a fresh lockfile]' \
                        '(-P --prod --production)'{-P,--prod,--production}'[Install production dependencies only]' \
                        '(-D --dev)'{-D,--dev}'[Install development dependencies only]' \
                        '--ignore-scripts[Skip lifecycle scripts]' \
                        '--no-optional[Skip optional dependencies]' \
                        '--offline[Disallow network access]' \
                        '--prefer-offline[Prefer cached packages]' \
                        '--lockfile-only[Only update the lockfile]' \
                        '--force[Force resolution and linking]' \
                        '--node-linker[Select node_modules layout]:layout:(isolated hoisted)' \
                        '--registry[Override the registry]:url:' \
                        '(-C --dir)'{-C,--dir}'[Run from a directory]:directory:_directories' \
                        '*'{-F,--filter}'[Filter workspace packages]:filter:' \
                        '(-r --recursive)'{-r,--recursive}'[Run across workspaces]' \
                        '--reporter[Select output format]:reporter:(default append-only silent)' \
                        '--loglevel[Set log level]:level:(silent error warn info debug)' \
                        '(-h --help)'{-h,--help}'[Show help]'
                    ;;
                add|a)
                    _arguments \
                        '(-D --save-dev)'{-D,--save-dev}'[Add as a development dependency]' \
                        '(-E --save-exact)'{-E,--save-exact}'[Save an exact version]' \
                        '(-g --global)'{-g,--global}'[Install globally]' \
                        '(-O --save-optional)'{-O,--save-optional}'[Add as an optional dependency]' \
                        '--save-peer[Add as a peer dependency]' \
                        '--no-save[Do not update package.json]' \
                        '--lockfile-only[Skip linking node_modules]' \
                        '(-w --workspace)'{-w,--workspace}'[Add to the workspace root]' \
                        '(-W --ignore-workspace-root-check)'{-W,--ignore-workspace-root-check}'[Allow adding at workspace root]' \
                        '--registry[Override the registry]:url:' \
                        '(-C --dir)'{-C,--dir}'[Run from a directory]:directory:_directories' \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '*:package:'
                    ;;
                store)
                    _arguments \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '1:store command:_nub_store_commands' \
                        '*:package:'
                    ;;
                config)
                    _arguments \
                        '--all[Include unset settings]' \
                        '--json[Output JSON]' \
                        '--local[Use project configuration]' \
                        '--location[Select configuration location]:location:(merged user project global)' \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '1:config command:_nub_config_commands' \
                        '*:setting or value:'
                    ;;
                help)
                    _arguments '*:command:_nub_commands'
                    ;;
                *)
                    _arguments \
                        '--cwd[Run as if started in a directory]:directory:_directories' \
                        '(-s --silent)'{-s,--silent}'[Suppress non-error output]' \
                        '*--verbose[Increase log verbosity]' \
                        '--color=-[Set color mode]:mode:(auto always never)' \
                        '(-h --help)'{-h,--help}'[Show help]' \
                        '*:argument:'
                    ;;
            esac
            ;;
    esac
}

_nub "$@"
