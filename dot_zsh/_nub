        'which:Print the resolved Node binary path'
        'install:Provision Node versions'
        'ls:List cached Node versions'
        'uninstall:Remove a cached Node version'
        'pin:Write the project Node version pin'
        'shim:Route node through nub'
        'unshim:Remove the node shim'
