}

cmd store subcommand_required=#true help="Manage the content-addressable store" {
  cmd add help="Add packages to the global store" {
    arg <package> var=#true help="Package specs to fetch into the store"
  }

  cmd path help="Show the store path"

  cmd prune help="Remove unreferenced packages" {
    flag --dry-run help="Do not actually delete anything; report what would be pruned"
    flag --json help="Emit the dry-run plan as one machine-readable JSON document"
  }

  cmd status help="Verify the store"

  cmd help help="Show help for a subcommand" {
    arg "[subcommand]" var=#true help="Subcommand to show help for" {
      choices add path prune status
    }
  }
}

cmd token subcommand_required=#true help="Manage registry tokens" {
  flag --fetch-retries help="Number of retry attempts for failed registry fetches" {
    arg <n>
  }
  flag --fetch-retry-factor help="Exponential backoff factor between retry attempts" {
    arg <n>
  }
  flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-timeout help="Per-request HTTP timeout in milliseconds" {
    arg <ms>
  }
  flag --registry help="Override the default registry URL for this invocation" {
    arg <url>
  }

  cmd create help="Create an auth token" {
    flag "-p --password" help="Account password" {
      arg <password>
    }
    flag --cidr help="Restrict the token to these CIDR ranges" var=#true {
      arg <cidr>
    }
    flag --read-only help="Create a read-only token"
  }

  cmd list help="List account tokens" {
    alias ls
  }

  cmd revoke help="Revoke an auth token" {
    alias rm
    arg <key> help="The token key, or a prefix of the token value"
  }

  cmd help help="Show help for a subcommand" {
    arg "[subcommand]" var=#true help="Subcommand to show help for" {
      choices create list ls revoke rm
    }
  }
}

cmd undeprecate help="Clear package deprecations" {
  flag --dry-run help="Print without updating"
  flag --fetch-retries help="Number of retry attempts for failed registry fetches" {
    arg <n>
  }
  flag --fetch-retry-factor help="Exponential backoff factor between retry attempts" {
    arg <n>
  }
  flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-timeout help="Per-request HTTP timeout in milliseconds" {
    arg <ms>
  }
  flag --otp help="One-time password from a 2FA authenticator; sent as `npm-otp`" {
    arg <code>
  }
  flag --registry help="Override the default registry URL for this invocation" {
    arg <url>
  }
  arg <package> help="Package spec: `name`, `name@version`, or `name@<range>`"
}

cmd unlink help="Unlink local packages" {
  alias dislink
  flag "-C --dir --cd --prefix" help="Change to directory before running (like `make -C`)" {
    arg <dir>
  }
  flag "-F --filter" help="Scope to workspace packages matching PATTERN (repeatable)" var=#true {
    arg <pattern>
  }
  flag "-g --global" help="Use the global link registry"
  flag "-r --recursive" help="Run across every workspace package (same as --filter=*)"
  flag --cpu help="CPU architecture(s) to install optional dependencies for" var=#true {
    arg <cpu> delimiter=","
  }
  flag --fail-if-no-match help="Error when a workspace selector matches no packages"
  flag --filter-prod help="Production-only variant of --filter" var=#true {
    arg <pattern>
  }
  flag --libc help="C library/libraries to install optional dependencies for (`glibc`, `musl`)" var=#true {
    arg <libc> delimiter=","
  }
  flag --loglevel help="Log level: logs at or above this level are shown" {
    arg <level> {
      choices silent error warn info debug
    }
  }
  flag --minimum-release-age help="How old a version must be before it can be installed: a duration with a unit (`30s`, `5m`, `2h`, `3d`, `1w`), or a bare number meaning minutes" {
    arg <duration>
  }
  flag --minimum-release-age-exclude help="Exempt packages from the age gate for this run (repeatable)" var=#true {
    arg <pkg>
  }
  flag --os help="Operating system(s) to install optional dependencies for" var=#true {
    arg <os> delimiter=","
  }
  flag --reporter help="Output format: `default`, `append-only`, or `silent`" {
    arg <name> {
      choices default append-only silent
    }
  }
  arg "[package]" help="Package name to unlink (omit to unlink all linked dependencies)"
}

cmd unpublish help="Remove a package or version from the registry" {
  flag "-f --force" help="Allow whole-package removal"
  flag --dry-run help="Print without updating"
  flag --fetch-retries help="Number of retry attempts for failed registry fetches" {
    arg <n>
  }
  flag --fetch-retry-factor help="Exponential backoff factor between retry attempts" {
    arg <n>
  }
  flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-timeout help="Per-request HTTP timeout in milliseconds" {
    arg <ms>
  }
  flag --otp help="One-time password for registries that require 2FA" {
    arg <code>
  }
  flag --registry help="Override the default registry URL for this invocation" {
    arg <url>
  }
  arg "[package]" help="Package spec: `name`, `name@version`, or omitted to use the current"
}

cmd update help="Update dependencies within range" {
  alias up
  flag "-C --dir --cd --prefix" help="Run from a directory" {
    arg <dir>
  }
  flag "-D --dev" help="Update development dependencies only"
  flag "-E --exact --save-exact" help="Save exact versions"
  flag "-F --filter" help="Filter workspace packages" var=#true {
    arg <pattern>
  }
  flag "-g --global" help="Update globally installed packages"
  flag "-i --interactive" help="Select packages interactively"
  flag "-L --latest" help="Update to latest versions, ignoring manifest ranges"
  flag "-P --prod --production" help="Update production dependencies only"
  flag "-r --recursive" help="Run across workspaces"
  flag "-w --workspace" help="Prefer workspace packages"
  flag --cpu help="CPU architecture(s) to install optional dependencies for" var=#true {
    arg <cpu> delimiter=","
  }
  flag --depth help="Set dependency traversal depth" {
    arg <depth>
  }
  flag "--disable-global-virtual-store --disable-gvs" help="Force the shared global virtual store off for this invocation"
  flag "--enable-global-virtual-store --enable-gvs" help="Force the shared global virtual store on for this invocation"
  flag --fail-if-no-match help="Error when a workspace selector matches no packages"
  flag --fetch-retries help="Number of retry attempts for failed registry fetches" {
    arg <n>
  }
  flag --fetch-retry-factor help="Exponential backoff factor between retry attempts" {
    arg <n>
  }
  flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-timeout help="Per-request HTTP timeout in milliseconds" {
    arg <ms>
  }
  flag --filter-prod help="Production-only variant of --filter" var=#true {
    arg <pattern>
  }
  flag --frozen-lockfile help="Error if the lockfile drifts from package.json"
  flag --global-pnpmfile help="Set the global pnpmfile" {
    arg <path>
  }
  flag --ignore-pnpmfile help="Skip pnpmfile hooks"
  flag --ignore-scripts help="Skip lifecycle scripts"
  flag --libc help="C library/libraries to install optional dependencies for (`glibc`, `musl`)" var=#true {
    arg <libc> delimiter=","
  }
  flag --lockfile-only help="Only update the lockfile"
  flag --loglevel help="Log level: logs at or above this level are shown" {
    arg <level> {
      choices silent error warn info debug
    }
  }
  flag --minimum-release-age help="How old a version must be before it can be installed: a duration with a unit (`30s`, `5m`, `2h`, `3d`, `1w`), or a bare number meaning minutes" {
    arg <duration>
  }
  flag --minimum-release-age-exclude help="Exempt packages from the age gate for this run (repeatable)" var=#true {
    arg <pkg>
  }
  flag --no-frozen-lockfile help="Always re-resolve, even if the lockfile is up to date"
  flag --no-optional help="Skip optional dependencies"
  flag --no-save help="Do not update package.json"
  flag --os help="Operating system(s) to install optional dependencies for" var=#true {
    arg <os> delimiter=","
  }
  flag --pnpmfile help="Set the local pnpmfile" {
    arg <path>
  }
  flag --prefer-frozen-lockfile help="Use the lockfile when fresh, re-resolve when stale"
  flag --registry help="Override the default registry URL for this invocation" {
    arg <url>
  }
  flag --reporter help="Output format: `default`, `append-only`, or `silent`" {
    arg <name> {
      choices default append-only silent
    }
  }
  arg "[package]" var=#true help="Package(s) to update (all if empty)"
}

cmd upgrade help="Upgrade nub" {
  flag "-y --yes" help="Skip confirmation"
  flag --canary help="Upgrade to canary"
  flag --dry-run help="Show actions without changing anything"
  flag --stable help="Upgrade to stable"
  flag --version help="Target version" {
    arg <version>
  }
}

cmd version help="Show or bump the package version" {
  flag "-m --message" help="Commit message template" {
    arg <message>
  }
  flag --allow-same-version help="Allow retaining the current version"
  flag --ignore-scripts help="Skip version lifecycle scripts"
  flag --json help="Output JSON"
  flag --no-commit-hooks help="Skip git commit hooks"
  flag --no-git-tag-version help="Do not create a commit or tag"
  flag --preid help="Prerelease identifier" {
    arg <id>
  }
  flag --sign-git-tag help="GPG-sign the tag"
  arg "[version]" help="Bump keyword or an explicit version string"
}

cmd view help="Show registry package metadata" {
  alias info show v
  flag "-C --dir" help="Change to directory before running" {
    arg <dir>
  }
  flag --fetch-retries help="Number of retry attempts for failed registry fetches" {
    arg <n>
  }
  flag --fetch-retry-factor help="Exponential backoff factor between retry attempts" {
    arg <n>
  }
  flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-timeout help="Per-request HTTP timeout in milliseconds" {
    arg <ms>
  }
  flag --json help="Output JSON"
  flag --registry help="Override the default registry URL for this invocation" {
    arg <url>
  }
  arg "[package]" help="Package to view, optionally with a version or dist-tag"
  arg "[field]" help="Dotted path into the version metadata to print"
}

cmd watch help="Run a file in watch mode" {
  arg <file> help="File to watch and execute"
  arg "[arg]" var=#true double_dash=automatic help="Remaining arguments forwarded to the script"
}

cmd whoami help="Show the current registry user" {
  flag --fetch-retries help="Number of retry attempts for failed registry fetches" {
    arg <n>
  }
  flag --fetch-retry-factor help="Exponential backoff factor between retry attempts" {
    arg <n>
  }
  flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-timeout help="Per-request HTTP timeout in milliseconds" {
    arg <ms>
  }
  flag --registry help="Override the default registry URL for this invocation" {
    arg <url>
  }
}

cmd why help="Explain why a package is installed" {
  alias w
  flag "-C --dir" help="Change to directory before running" {
    arg <dir>
  }
  flag "-D --dev" help="Search development dependencies only"
  flag "-F --filter" help="Scope to workspace packages matching PATTERN (repeatable)" var=#true {
    arg <pattern>
  }
  flag "-P --prod --production" help="Search production dependencies only"
  flag "-r --recursive" help="Run across every workspace package (same as `--filter=*`)"
  flag --fail-if-no-match help="Error when a workspace selector matches no packages"
  flag --filter-prod help="Production-only variant of `--filter`: graph walks skip devDependencies" var=#true {
    arg <pattern>
  }
  flag --include-workspace-root help="Include the workspace root alongside the selected packages"
  flag --json help="Output JSON"
  flag --long help="Show extended package details"
  flag --parseable help="Output parseable paths"
  arg <package> help="Package name to search for (exact match against package names)"
}

complete "script" run="jq -r '.scripts // {} | keys[]' package.json 2>/dev/null"
complete "bin" run="node -e \"require('fs').readdirSync('node_modules/.bin').forEach(x => console.log(x))\" 2>/dev/null"
complete "file" type="file"
complete "dir" type="dir"
complete "path" type="path"
