cmd dist-tag subcommand_required=#true help="Manage distribution tags" {
  alias dist-tags
  flag --fetch-retries help="Number of retry attempts for failed registry fetches" {
    arg <n>
  }
  flag --fetch-retry-factor help="Exponential backoff factor between retry attempts" {
    arg <n>
  }
  flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-timeout help="Per-request HTTP timeout in milliseconds" {
    arg <ms>
  }
  flag --registry help="Override the default registry URL for this invocation" {
    arg <url>
  }

  cmd add help="Add or update a distribution tag" {
    flag --otp help="One-time password from a 2FA authenticator; sent as `npm-otp`" {
      arg <code>
    }
    arg <package-version> help="Package spec in `name@version` form (exact version required, ranges"
    arg "[tag]" help="Tag to create or update. Defaults to `latest`"
  }

  cmd ls help="List distribution tags" {
    arg "[package]" help="Package name (no version)"
  }

  cmd rm help="Remove a distribution tag" {
    alias remove
    flag --otp help="One-time password from a 2FA authenticator; sent as `npm-otp`" {
      arg <code>
    }
    arg <package> help="Package name (no version)"
    arg <tag> help="Tag to remove"
  }

  cmd help help="Show help for a subcommand" {
    arg "[subcommand]" var=#true help="Subcommand to show help for" {
      choices add ls remove rm
    }
  }
}

cmd dlx help="Fetch and run a package binary" {
  alias x
  flag "-C --dir --cd --prefix" help="Run from a directory" {
    arg <dir>
  }
  flag "-c --shell-mode" help="Run the command through sh -c"
  flag "-F --filter" help="Filter workspace packages" var=#true {
    arg <workspace>
  }
  flag "-p --package" help="Fetch an explicit package" var=#true {
    arg <package>
  }
  flag "-r --recursive" help="Run across workspaces"
  flag --allow-build help="Allow lifecycle scripts (use --allow-build=package)" var=#true {
    arg <package>
  }
  flag --cpu help="Select target CPU architectures" var=#true {
    arg <cpu> delimiter=","
  }
  flag "--disable-global-virtual-store --disable-gvs" help="Disable the shared virtual store"
  flag "--enable-global-virtual-store --enable-gvs" help="Enable the shared virtual store"
  flag --fail-if-no-match help="Fail when no workspace matches"
  flag --fetch-retries help="Set registry retry attempts" {
    arg <count>
  }
  flag --fetch-retry-factor help="Set the retry backoff factor" {
    arg <count>
  }
  flag --fetch-retry-maxtimeout help="Set maximum retry backoff in milliseconds" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Set minimum retry backoff in milliseconds" {
    arg <ms>
  }
  flag --fetch-timeout help="Set request timeout in milliseconds" {
    arg <ms>
  }
  flag --filter-prod help="Filter production workspace packages" var=#true {
    arg <workspace>
  }
  flag --frozen-lockfile help="Fail when the lockfile is stale"
  flag --libc help="Select target C libraries" var=#true {
    arg <libc> delimiter="," {
      choices glibc musl current "*"
    }
  }
  flag --loglevel help="Set log level" {
    arg <level> {
      choices silent error warn info debug
    }
  }
  flag --minimum-release-age help="Set minimum package age" {
    arg <duration>
  }
  flag --minimum-release-age-exclude help="Exempt a package from the age gate" var=#true {
    arg <package>
  }
  flag --no-frozen-lockfile help="Always resolve dependencies"
  flag --os help="Select target operating systems" var=#true {
    arg <os> delimiter=","
  }
  flag --prefer-frozen-lockfile help="Reuse a fresh lockfile"
  flag --registry help="Override the registry" {
    arg <url>
  }
  flag --reporter help="Select output format" {
    arg <reporter> {
      choices default append-only silent
    }
  }
  arg "[package]" help="Package"
  arg "[arg]" var=#true double_dash=automatic help="Arg"
}

