    }

    cmd get help="Get a user setting" {
      flag --json help="Output JSON"
      arg <key> help="Key"
    }

    cmd init help="Create the user nub.jsonc"

    cmd list help="List user settings" {
      alias ls
      flag --json help="Output JSON"
    }

    cmd path help="Show the user nub.jsonc path"

    cmd set help="Set a user setting" {
      arg <key> help="Key"
      arg <value> help="Value"
    }
  }
}

