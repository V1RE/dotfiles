    arg <dir>
  }
  flag "-g --global" help="Show the global bin directory"
  flag "-w --workspace-root --workspace" help="Show the workspace-root bin directory"
}

cmd cache subcommand_required=#true help="Manage cached package data" {
  cmd delete help="Delete package metadata" {
    arg <pattern> var=#true help="One or more package name patterns"
  }

  cmd list help="List cached package metadata" {
    arg "[pattern]" var=#true help="Optional glob patterns to filter the listing"
  }

  cmd list-registries help="List configured registries"

  cmd path help="Show the metadata and policy cache directory"

  cmd prune help="Remove stale cache primers" {
    flag --age-days help="Minimum age in days before an old primer file is removed" {
      arg <days>
    }
    flag --dry-run help="Do not actually delete anything"
  }

  cmd view help="View cached package metadata" {
    flag --json help="Dump the raw on-disk cache JSON instead of a summary"
    arg <package> help="Package name (scoped names like `@babel/core` are accepted)"
  }

  cmd help help="Show help for a subcommand" {
    arg "[subcommand]" var=#true help="Subcommand to show help for" {
      choices delete list list-registries path prune view
    }
  }
}

