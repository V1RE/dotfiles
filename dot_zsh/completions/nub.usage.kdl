cmd config help="Manage configuration" {
  alias c
  flag "-g --global" help="Use user configuration"
  flag --all help="Include settings with no configured value"
  flag --json help="Output JSON"
  flag --local help="Use project configuration"

  cmd delete help="Remove a setting" {
    alias rm remove unset
    flag "-g --global" help="Use the user configuration instead of the project configuration"
    flag --local help="Use the project configuration (the default)"
    arg <key> help="The setting key"
  }

  cmd get help="Get a setting" {
    flag "-g --global" help="Read only the user configuration"
    flag --json help="Emit the value as JSON"
    flag --local help="Read only the project configuration"
    arg <key> help="The setting key"
  }

  cmd init help="Create a commented nub.jsonc" {
    flag "-g --global" help="Create the user configuration instead of the project configuration"
    flag --local help="Create the project file (the default)"
  }

  cmd list help="List settings" {
    alias ls
    flag "-g --global" help="List only the user configuration"
    flag --all help="Also list settings that have no value set"
    flag --json help="Emit all entries as a JSON object keyed by setting name"
    flag --local help="List only the project configuration"
  }

  cmd path help="Show the global nub.jsonc path" {
    flag "-g --global" help="Print the user configuration path"
  }

  cmd set help="Set a setting" {
    flag "-g --global" help="Use the user configuration instead of the project configuration"
    flag --local help="Use the project configuration (the default)"
    arg <key> help="Setting key (canonical name or `.npmrc` alias)"
    arg <value> help="Value to write. Stored verbatim after `key=`"
  }

  cmd help help="Show help for a subcommand" {
    arg "[subcommand]" var=#true help="Subcommand to show help for" {
      choices delete get init list ls path remove rm set unset
    }
  }
}

