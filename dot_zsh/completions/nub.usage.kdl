  flag "-F --filter" help="Filter workspace packages" var=#true {
    arg <pattern>
  }
  flag "-P --prod" help="Fetch production dependencies only"
  flag --registry help="Override the registry" {
    arg <url>
  }
}

cmd find-hash help="Find packages containing a content hash" {
