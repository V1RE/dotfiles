name nub
bin nub
version "0.9.3"
about "The all-in-one Node.js toolkit"
// Source: nubjs/nub v0.9.3 (`--help` and command-specific help).
// Regenerated locally by chezmoi; do not add the generated .zsh/_nub.

flag "-c --check" help="Syntax-check without executing"
flag "-C --conditions" help="Add an export condition" var=#true {
  arg <name>
}
// Node passthrough flags are root-only: -r and -C mean different things for PM verbs.
flag "-e --eval" help="Evaluate code" {
  arg <code>
}
flag "-h --help" help="Show help" global=#true
flag "-p --print" help="Evaluate code and print the result" {
  arg <code>
}
flag "-r --require" help="Preload a CommonJS module" var=#true {
  arg <module>
}
flag "-s --silent" help="Suppress non-error output" global=#true
flag "-v --version" help="Show version"
flag --color help="Set color mode" global=#true {
  arg "[color]" {
    choices auto always never
  }
}
flag --cpu-prof help="Write a V8 CPU profile on exit"
flag --cwd help="Run as if started in a directory" global=#true {
  arg <dir>
}
flag --disable-warning help="Silence a specific warning" var=#true {
  arg <code-or-type>
}
flag --enable-source-maps help="Enable source maps in stack traces"
flag --env-file help="Load environment variables from a file" global=#true {
  arg <file>
}
flag --env-file-if-exists help="Load an optional environment file" global=#true {
  arg <file>
}
flag --heap-prof help="Write a V8 heap profile on exit"
flag --import help="Preload an ES module" var=#true {
  arg <module>
}
flag --input-type help="Select the eval or stdin module format" {
  arg <type> {
    choices module commonjs
  }
}
flag --inspect help="Activate the inspector" {
  arg "[host:port]"
}
flag --inspect-brk help="Break at startup in the inspector" {
  arg "[host:port]"
}
flag --inspect-wait help="Wait for an inspector connection" {
  arg "[host:port]"
}
flag --max-old-space-size help="Set V8's old-space size limit" {
  arg <mb>
}
flag "--no-check --no-install" help="Skip dependency freshness checks"
flag --no-color help="Disable color" global=#true
flag --no-deprecation help="Silence deprecation warnings"
flag --no-env-file help="Disable environment-file loading" global=#true
flag --no-warnings help="Silence all process warnings"
flag --node help="Disable nub runtime augmentation" global=#true
flag --pending-deprecation help="Emit pending deprecation warnings"
flag --preserve-symlinks
flag --preserve-symlinks-main
flag --prof help="Generate V8 profiler tick data"
flag --redirect-warnings help="Write warnings to a file" {
  arg <file>
}
flag --report-dir {
  arg <dir>
}
flag --report-filename {
  arg <file>
}
flag --report-on-fatalerror
flag --report-on-signal
flag --report-uncaught-exception
flag --stack-trace-limit help="Set Error.stackTraceLimit" {
  arg <n>
}
flag --throw-deprecation help="Throw on use of deprecated APIs"
flag --title help="Set process.title on startup" {
  arg <title>
}
flag --trace-deprecation help="Show stack traces for deprecations"
flag --trace-exit
flag --trace-sync-io
flag --trace-uncaught
flag --trace-warnings help="Show stack traces for process warnings"
flag --use-largepages {
  arg <mode>
}
flag --v8-options
flag --verbose help="Increase log verbosity" count=#true global=#true
flag --watch help="Enable watch mode" global=#true
flag --watch-path help="Watch a path" var=#true {
  arg <path>
}
flag --watch-preserve-output help="Preserve output across restarts"
flag --zero-fill-buffers
// Keep bare nub completion focused on commands, not files in the current directory.
arg "[entry]" required=#false
complete "entry" type="none"
arg "[arg]" required=#false var=#true

cmd add help="Add dependencies" {
  alias a
  flag "-C --dir --cd --prefix" help="Run from a directory" {
    arg <dir>
  }
  flag "-D --save-dev" help="Add as a development dependency"
  flag "-E --save-exact" help="Save an exact version"
  flag "-F --filter" help="Filter workspace packages" var=#true {
    arg <pattern>
  }
  flag "-g --global" help="Install globally"
  flag "-O --save-optional" help="Add as an optional dependency"
  flag "-r --recursive" help="Run across workspaces"
  flag "-w --workspace" help="Add from the workspace"
  flag "-W --ignore-workspace-root-check" help="Allow adding at workspace root"
  flag --allow-build help="Allow dependency build scripts" var=#true {
    arg <package>
  }
  flag --allow-low-downloads help="Bypass low-download safety prompts"
  flag --dangerously-allow-all-builds help="Allow all dependency build scripts"
  flag --deny-build help="Deny dependency build scripts" var=#true {
    arg <package>
  }
  flag "--disable-global-virtual-store --disable-gvs" help="Disable the shared virtual store"
  flag "--enable-global-virtual-store --enable-gvs" help="Enable the shared virtual store"
  flag --fetch-retries {
    arg <count>
  }
  flag --fetch-retry-factor {
    arg <count>
  }
  flag --fetch-retry-maxtimeout {
    arg <ms>
  }
  flag --fetch-retry-mintimeout {
    arg <ms>
  }
  flag --fetch-timeout {
    arg <ms>
  }
  flag --filter-prod help="Filter production workspace packages" var=#true {
    arg <pattern>
  }
  flag --frozen-lockfile help="Fail when the lockfile is stale"
  flag --lockfile-only help="Skip linking node_modules"
  flag --no-frozen-lockfile help="Always resolve dependencies"
  flag --no-save help="Do not update package.json"
  flag --no-save-workspace-protocol help="Save registry-style workspace specifiers"
  flag --prefer-frozen-lockfile help="Reuse a fresh lockfile"
  flag --registry help="Override the registry" {
    arg <url>
  }
  flag --save-catalog help="Save into the default workspace catalog"
  flag --save-catalog-name help="Save into a named workspace catalog" {
    arg <name>
  }
  flag --save-peer help="Add as a peer dependency"
  flag --save-workspace-protocol help="Save workspace: specifiers"
  arg <package> var=#true
}

cmd agent subcommand_required=#true help="Print documentation for coding agents" {
  cmd docs help="Print the documentation index and content" {
    flag "--list --toc" help="Print only the page TOC"
    flag --page help="Print one documentation page" {
      arg <path>
    }
  }

  cmd skill help="Print Nub's agent skill"
}

cmd approve-builds help="Approve dependencies to run build scripts" {
  flag "-g --global" help="Approve global packages"
  flag --all help="Approve every pending ignored build without prompting"
  arg "[package]" required=#false var=#true
}

cmd audit help="Audit dependencies for vulnerabilities" {
  flag "-D --dev" help="Audit development dependencies only"
  flag "-i --interactive" help="Choose advisories to fix"
  flag "-P --prod --production" help="Audit production dependencies only"
  flag --audit-level help="Minimum severity" {
    arg <level> {
      choices info low moderate high critical
    }
  }
  flag --fix help="Fix advisories" {
    arg "[mode]" required=#false {
      choices update override
    }
  }
  flag --ignore help="Ignore an advisory ID" var=#true {
    arg <id>
  }
  flag --ignore-registry-errors help="Exit successfully on registry errors"
  flag --ignore-unfixable help="Hide advisories with no upgrade"
  flag --json help="Output JSON"
  flag --no-optional help="Skip optional dependencies"
}

cmd bin help="Show the binary directory" {
  flag "-g --global" help="Show the global bin directory"
  flag "-w --workspace-root --workspace" help="Show the workspace-root bin directory"
}

cmd cache subcommand_required=#true help="Manage cached package data" {
  cmd delete help="Delete package metadata" {
    arg <pattern> var=#true
  }

  cmd list help="List cached package metadata" {
    arg "[pattern]" required=#false var=#true
  }

  cmd list-registries help="List configured registries"

  cmd path help="Show the metadata and policy cache directory"

  cmd prune help="Remove stale cache primers" {
    flag --age-days {
      arg <days>
    }
    flag --dry-run
  }

  cmd view help="View cached package metadata" {
    flag --json
    arg <package>
  }
}

cmd cat-file help="Find a store file by content hash" {
  arg <hash>
}

cmd cat-index help="Show a package's store index" {
  arg <package-version>
}

cmd check help="Check dependency link consistency" {
  flag --json help="Output JSON"
}

cmd ci help="Perform a clean frozen-lockfile install" {
  flag "-C --dir" help="Run from a directory" {
    arg <dir>
  }
  flag "-D --dev" help="Install development dependencies only"
  flag "-F --filter" help="Filter workspace packages" var=#true {
    arg <pattern>
  }
  flag "-P --prod --production" help="Install production dependencies only"
  flag "-r --recursive" help="Run across workspaces"
  flag --cpu help="Select target CPU architectures" var=#true {
    arg <cpu>
  }
  flag --cwd help="Run from a directory" {
    arg <dir>
  }
  flag --fail-if-no-match help="Fail when no workspace matches"
  flag --filter-prod help="Filter production workspace packages" var=#true {
    arg <pattern>
  }
  flag --ignore-scripts help="Skip lifecycle scripts"
  flag --include-workspace-root help="Include the workspace root"
  flag --libc help="Select target C libraries" var=#true {
    arg <libc> {
      choices glibc musl current "*"
    }
  }
  flag --loglevel help="Set log level" {
    arg <level> {
      choices silent error warn info debug
    }
  }
  flag --minimum-release-age help="Set minimum package age" {
    arg <duration>
  }
  flag --minimum-release-age-exclude help="Exempt a package from the age gate" var=#true {
    arg <package>
  }
  flag --no-optional help="Skip optional dependencies"
  flag --os help="Select target operating systems" var=#true {
    arg <os>
  }
  flag --registry help="Override the registry" {
    arg <url>
  }
  flag --reporter help="Select output format" {
    arg <reporter> {
      choices default append-only silent
    }
  }
}

cmd compile help="Compile a file to a standalone executable" {
  arg <file>
  flag --alias help="Remap a module specifier" var=#true {
    arg "<from=to>"
  }
  flag --allow-dynamic-import help="Allow computed dynamic imports, optionally scoped by glob" var=#true {
    arg "[glob]" required=#false
  }
  flag --bundled help="Force bundling a package" var=#true {
    arg <package>
  }
  flag --conditions help="Add an export condition" var=#true {
    arg <name>
  }
  flag --define help="Replace an expression" var=#true {
    arg "<key=value>"
  }
  flag --define-file help="Replace an expression with file contents" var=#true {
    arg "<key=path>"
  }
  flag --drop help="Remove calls at build time" var=#true {
    arg <name> {
      choices console debugger
    }
  }
  flag --exclude help="Exclude an embedded path or glob" var=#true {
    arg <path>
  }
  flag --external help="Resolve a package outside the binary at runtime" var=#true {
    arg <package>
  }
  flag --hide-console help="Hide the console window for a Windows GUI app"
  flag --icon help="Set a Windows executable icon" {
    arg <file>
  }
  flag --icu help="Keep selected ICU locales (use --icu=locales)" {
    arg "[locales]" required=#false
  }
  flag --ignore-annotations help="Ignore pure annotations"
  flag --include help="Embed a file, directory, or glob" var=#true {
    arg <path>
  }
  flag --install-message help="Set the first-run setup message" {
    arg <text>
  }
  flag --loader help="Set the loader for an extension" var=#true {
    arg "<ext=type>"
  }
  flag --metadata help="Set Windows version metadata" var=#true {
    arg "<key=value>"
  }
  flag --metafile help="Write an esbuild-format build report" {
    arg <path>
  }
  flag --no-keep-names help="Allow renaming functions and classes"
  flag --no-minify help="Disable minification"
  flag --no-treeshake help="Disable tree shaking"
  flag --node-options help="Set startup Node options" var=#true {
    arg <options>
  }
  flag --out help="Set the output executable path" {
    arg <path>
  }
  flag --platform help="Select the target platform" {
    arg <platform> {
      choices darwin-arm64 darwin-x64 linux-arm64 linux-arm64-musl linux-x64 linux-x64-musl win32-arm64 win32-x64
    }
  }
  flag --smol help="Discover or provision Node at runtime instead of embedding it"
  flag --sourcemap help="Set source map mode (use --sourcemap=mode)" {
    arg "[mode]" {
      choices linked inline external none
    }
  }
  flag --sourcemap-exclude-sources help="Omit original source text from maps"
  flag --target help="Select the target Node version or alias" {
    arg <version>
  }
  flag --tsconfig help="Use a specific TypeScript configuration" {
    arg <path>
  }
  flag --unbundled help="Embed a package in its installed layout" var=#true {
    arg <package>
  }
}

cmd config help="Manage configuration" {
  alias c
  flag "-g --global" help="Use user configuration"
  // Scope selectors are explicit here because config has its own global/user grammar.
  flag --all help="Include settings with no configured value"
  flag --json help="Output JSON"
  flag --local help="Use project configuration"

  cmd delete help="Remove a setting" {
    alias rm remove unset
    flag "-g --global"
    flag --local
    arg <key>
  }

  cmd get help="Get a setting" {
    flag "-g --global"
    flag --json
    flag --local
    arg <key>
  }

  cmd init help="Create a commented nub.jsonc" {
    flag "-g --global"
    flag --local
  }

  cmd list help="List settings" {
    alias ls
    flag "-g --global"
    flag --all
    flag --json
    flag --local
  }

  cmd path help="Show the global nub.jsonc path"

  cmd set help="Set a setting" {
    flag "-g --global"
    flag --local
    arg <key>
    arg <value>
  }
}

cmd create help="Create a project from a create-* initializer" {
  flag --registry help="Override the registry" {
    arg <url>
  }
  arg "[param]" required=#false var=#true
}

cmd dedupe help="Remove duplicate packages" {
  flag --check help="Exit non-zero if dedupe would change the lockfile"
  flag --registry help="Override the registry" {
    arg <url>
  }
}

cmd deprecate help="Deprecate published package versions" {
  flag --dry-run help="Print without updating"
  flag --otp {
    arg <code>
  }
  arg <package>
  arg <message>
}

cmd deprecations help="Find deprecated installed dependencies" {
  flag --exit-code help="Fail when deprecations are found"
  flag --json help="Output JSON"
  flag --transitive help="Include transitive dependencies"
}

cmd dist-tag subcommand_required=#true help="Manage distribution tags" {
  alias dist-tags

  cmd add help="Add or update a distribution tag" {
    flag --otp {
      arg <code>
    }
    arg <package-version>
    arg "[tag]" required=#false
  }

  cmd ls help="List distribution tags" {
    arg "[package]" required=#false
  }

  cmd rm help="Remove a distribution tag" {
    alias remove
    flag --otp {
      arg <code>
    }
    arg <package>
    arg <tag>
  }
}

