name nub
bin nub
version "0.9.6"
about "The all-in-one Node.js toolkit"
// Source: nubjs/nub v0.9.6 (recursive `--help` and usage_rs declarations).
// Regenerated locally by chezmoi; do not add the generated .zsh/_nub.

flag "-c --check" help="Syntax-check without executing"
flag "-C --conditions" help="Add an export condition" var=#true {
  arg <name>
}
// Node passthrough flags are root-only: -r and -C mean different things for PM verbs.
flag "-e --eval" help="Evaluate code" {
  arg <code>
}
flag "-h --help" help="Show help" global=#true
flag "-p --print" help="Evaluate code and print the result" {
  arg <code>
}
flag "-r --require" help="Preload a CommonJS module" var=#true {
  arg <module>
}
flag "-s --silent" help="Suppress non-error output" global=#true
flag "-v --version -V" help="Show version"
flag --color help="Set color mode" global=#true default_missing="always" {
  arg "[color]" {
    choices auto always never
  }
}
flag --cpu-prof help="Write a V8 CPU profile on exit"
flag --cwd help="Run as if started in a directory" global=#true {
  arg <dir>
}
flag --disable-warning help="Silence a specific warning" var=#true {
  arg <code-or-type>
}
flag --enable-source-maps help="Enable source maps in stack traces"
flag --env-file help="Load environment variables from a file" var=#true {
  arg <file>
}
flag --env-file-if-exists help="Load an optional environment file" var=#true {
  arg <file>
}
flag --heap-prof help="Write a V8 heap profile on exit"
flag --import help="Preload an ES module" var=#true {
  arg <module>
}
flag --input-type help="Select the eval or stdin module format" {
  arg <type> {
    choices module commonjs
  }
}
flag --inspect help="Activate the inspector" {
  arg "[host:port]"
}
flag --inspect-brk help="Break at startup in the inspector" {
  arg "[host:port]"
}
flag --inspect-wait help="Wait for an inspector connection" {
  arg "[host:port]"
}
flag --max-old-space-size help="Set V8's old-space size limit" {
  arg <mb>
}
flag "--no-check --no-install" help="Skip dependency freshness checks"
flag --no-color help="Disable color" global=#true
flag --no-deprecation help="Silence deprecation warnings"
flag --no-env-file help="Disable environment-file loading"
flag --no-warnings help="Silence all process warnings"
flag --node help="Disable nub runtime augmentation"
flag --pending-deprecation help="Emit pending deprecation warnings"
flag --preserve-symlinks help="Preserve symlinks when resolving modules"
flag --preserve-symlinks-main help="Preserve symlinks for the entry module"
flag --prof help="Generate V8 profiler tick data"
flag --redirect-warnings help="Write warnings to a file" {
  arg <file>
}
flag --report-dir help="Set the diagnostic report directory" {
  arg <dir>
}
flag --report-filename help="Set the diagnostic report filename" {
  arg <file>
}
flag --report-on-fatalerror help="Write a diagnostic report on fatal errors"
flag --report-on-signal help="Write a diagnostic report on a signal"
flag --report-uncaught-exception help="Write a diagnostic report on uncaught exceptions"
flag --stack-trace-limit help="Set Error.stackTraceLimit" {
  arg <n>
}
flag --throw-deprecation help="Throw on use of deprecated APIs"
flag --title help="Set process.title on startup" {
  arg <title>
}
flag --trace-deprecation help="Show stack traces for deprecations"
flag --trace-exit help="Show a stack trace on process exit"
flag --trace-sync-io help="Show stack traces for synchronous I/O"
flag --trace-uncaught help="Show stack traces for uncaught exceptions"
flag --trace-warnings help="Show stack traces for process warnings"
flag --use-largepages help="Select how to use large memory pages" {
  arg <mode> {
    choices off on silent
  }
}
flag --v8-options help="Print V8 command-line options"
flag --verbose help="Increase log verbosity" count=#true global=#true
flag --watch help="Enable watch mode"
flag --watch-path help="Watch a path" var=#true {
  arg <path>
}
flag --watch-preserve-output help="Preserve output across restarts"
flag --zero-fill-buffers help="Zero-fill newly allocated buffers"
// Keep bare nub completion focused on commands, not files in the current directory.
arg "[entry]" required=#false help="File to run, or - for stdin"
complete "entry" type="none"
arg "[arg]" required=#false var=#true help="Arguments forwarded to the script"

cmd add help="Add dependencies" {
  alias a
  flag "-C --dir --cd --prefix" help="Run from a directory" {
    arg <dir>
  }
  flag "-D --save-dev" help="Add as a development dependency"
  flag "-E --save-exact" help="Save an exact version"
  flag "-F --filter" help="Filter workspace packages" var=#true {
    arg <pattern>
  }
  flag "-g --global" help="Install globally"
  flag "-O --save-optional" help="Add as an optional dependency"
  flag "-r --recursive" help="Run across workspaces"
  flag "-W --ignore-workspace-root-check" help="Allow adding at workspace root"
  flag "-w --workspace" help="Add from the workspace"
  flag --allow-build help="Allow dependency build scripts" var=#true {
    arg <package>
  }
  flag --allow-low-downloads help="Bypass low-download safety prompts"
  flag --cpu help="CPU architecture(s) to install optional dependencies for" var=#true {
    arg <cpu> delimiter=","
  }
  flag --dangerously-allow-all-builds help="Allow all dependency build scripts"
  flag --deny-build help="Deny dependency build scripts" var=#true {
    arg <package>
  }
  flag "--disable-global-virtual-store --disable-gvs" help="Disable the shared virtual store"
  flag "--enable-global-virtual-store --enable-gvs" help="Enable the shared virtual store"
  flag --fail-if-no-match help="Error when a workspace selector matches no packages"
  flag --fetch-retries help="Number of retry attempts for failed registry fetches" {
    arg <count>
  }
  flag --fetch-retry-factor help="Exponential backoff factor between retry attempts" {
    arg <count>
  }
  flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff" {
    arg <ms>
  }
  flag --fetch-timeout help="Per-request HTTP timeout in milliseconds" {
    arg <ms>
  }
  flag --filter-prod help="Filter production workspace packages" var=#true {
    arg <pattern>
  }
  flag --frozen-lockfile help="Fail when the lockfile is stale"
  flag --global-pnpmfile help="Add a global pnpmfile that runs before the local one" {
    arg <path>
  }
  flag --ignore-pnpmfile help="Skip running `.pnpmfile.mjs` / `.pnpmfile.cjs` hooks for this add"
  flag --libc help="C library/libraries to install optional dependencies for (`glibc`, `musl`)" var=#true {
    arg <libc> delimiter=","
  }
  flag --lockfile-only help="Skip linking node_modules"
  flag --loglevel help="Log level: logs at or above this level are shown" {
    arg <level> {
      choices silent error warn info debug
    }
  }
  flag --minimum-release-age help="How old a version must be before it can be installed: a duration with a unit (`30s`, `5m`, `2h`, `3d`, `1w`), or a bare number meaning minutes" {
    arg <duration>
  }
  flag --minimum-release-age-exclude help="Exempt packages from the age gate for this run (repeatable)" var=#true {
    arg <pkg>
  }
  flag --no-frozen-lockfile help="Always resolve dependencies"
  flag --no-save help="Do not update package.json"
  flag --no-save-workspace-protocol help="Save registry-style workspace specifiers"
  flag --os help="Operating system(s) to install optional dependencies for" var=#true {
    arg <os> delimiter=","
  }
  flag --pnpmfile help="Run this pnpmfile instead of the project's own one" {
    arg <path>
  }
  flag --prefer-frozen-lockfile help="Reuse a fresh lockfile"
  flag --registry help="Override the registry" {
    arg <url>
  }
  flag --reporter help="Output format: `default`, `append-only`, or `silent`" {
    arg <name> {
      choices default append-only silent
    }
  }
  flag --save-catalog help="Save into the default workspace catalog"
  flag --save-catalog-name help="Save into a named workspace catalog" {
    arg <name>
  }
  flag --save-peer help="Add as a peer dependency"
  flag --save-workspace-protocol help="Save workspace: specifiers"
  arg "[package]" var=#true help="Package(s) to add"
}

cmd agent subcommand_required=#true help="Print documentation for coding agents" {
  cmd docs help="Print the documentation index and content" {
    flag "--list --toc" help="Print only the page TOC"
    flag --page help="Print one documentation page" {
      arg <path>
    }
  }

  cmd skill help="Print Nub's agent skill"
}

