  alias adduser
  flag --auth-type help="Authentication flow" {
    arg <type> {
      choices legacy web
    }
  }
  flag --registry {
    arg <url>
  }
  flag --scope help="Bind a scope to this registry" {
    arg <scope>
  }
}

